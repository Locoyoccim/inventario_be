# --- Servidor ---
PORT=4000
# En producción: production, literal (otros valores como staging cambian el comportamiento de la cookie y del CORS).
NODE_ENV=development
# Cuántos proxies hay entre el cliente y la API (0 a 5; por defecto 1). Con el front (Caddy) de Railway delante de la API son 3 (medido en producción).
# De él depende req.ip: límite por IP, eventos de seguridad y la IP de la bitácora.
# TRUST_PROXY_HOPS=1
# Zona horaria de respaldo si una empresa no tiene la suya (por defecto America/Mexico_City) y tope de conexiones del pool.
# TZ_NEGOCIO=America/Mexico_City
# DB_POOL_MAX=10

# --- Base de datos ---
# La app se conecta con el rol gh_app (privilegios mínimos); las migraciones con el rol gh_migrador (dueño de las tablas).
# Nunca uses un superusuario aquí: en producción la app se niega a arrancar. Ver docs/DB_ROLES.md (npm run db:roles).
# Local: variables DB_*. En Railway/producción usa DATABASE_URL (+ DB_SSL=require).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=inventarios
# DATABASE_URL=postgres://gh_app:password@host:5432/inventarios
# MIGRATE_DATABASE_URL=postgres://gh_migrador:password@host:5432/inventarios   # rol migrador: lo usa npm run migrate
#   (en producción, idealmente solo en el job que migra, no en el entorno de la app en ejecución)
# PERMITIR_DB_SUPERUSUARIO=1   # SOLO emergencia: deja arrancar en producción con un rol con privilegios de más (aviso fuerte)
# DB_SSL=require

# --- Autenticación ---
# Genera CADA secreto con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Nunca reutilices un secreto entre desarrollo, pruebas y producción. En producción el servidor NO arranca si
# JWT_SECRET/PIN_PEPPER/SETUP_TOKEN son de ejemplo, repetitivos, cortos o iguales entre sí.
JWT_SECRET=<genera-uno>
JWT_EXPIRES=7d
# Opcional: blinda POST /api/auth/setup exigiendo el header x-setup-token
# SETUP_TOKEN=            # OBLIGATORIO en producción (24+ caracteres); en desarrollo es opcional
# Ingreso con PIN en equipos registrados: duración de la sesión (un turno) y pimienta del hash del PIN
# Obligatoria en producción y DISTINTA de JWT_SECRET (32+): así rotar el secreto de sesión no invalida los PIN.
# En desarrollo, si no se define, se usa JWT_SECRET (rotarlo invalida los PIN ya guardados). Cambiarla invalida los PIN.
# PIN_SESSION_EXPIRES=12h
# PIN_PEPPER=

# --- Cookie de sesión (frontend web) ---
# El login deja el JWT en una cookie httpOnly "gh_session" (además de devolverlo en el body).
# lax (recomendado): front y back en el mismo sitio (mismo dominio o subdominios, ej. app.aroma.mx + api.aroma.mx).
# none: front y back en dominios distintos (ej. dos *.up.railway.app). Requiere HTTPS (Secure automático).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true        # por defecto: true en producción
# COOKIE_DOMAIN=.aroma.mx   # solo si front y back están en subdominios distintos

# --- Correo (invitaciones de nuevos Owners) ---
# Cualquier proveedor SMTP (Resend, SendGrid, Postmark, Gmail, el del hosting...). Sin esto el sistema funciona:
# el alta de empresa devuelve el enlace de activación para entregarlo a mano.
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com
# (o) SMTP_HOST=smtp.proveedor.com  SMTP_PORT=587  SMTP_USER=...  SMTP_PASS=...  SMTP_SECURE=false
# MAIL_FROM="Gastronomy Hub <no-reply@tudominio.com>"
# Dirección pública del front para los enlaces del correo (por defecto, el primer CORS_ORIGINS).
# APP_URL=https://app.tudominio.com

# --- Sentry (opcional; apagado si no hay DSN) ---
# Recibe solo los errores 500 inesperados y los fallos fatales del proceso, sin datos de la petición ni de personas.
# Ver docs/OBSERVABILIDAD.md. Sin SENTRY_DSN el paquete ni se carga.
# SENTRY_DSN=https://clave@oXXXX.ingest.sentry.io/YYYY
# SENTRY_ENVIRONMENT=production   # por defecto NODE_ENV
# SENTRY_RELEASE=                 # por defecto RAILWAY_GIT_COMMIT_SHA

# --- CORS ---
# Orígenes permitidos separados por coma (con credenciales, "*" no es válido).
# Vacío: en desarrollo acepta cualquier origen. En producción es OBLIGATORIO: sin él el servidor no arranca
# (si el front y la API comparten URL, pon la URL pública del front).
# CORS_ORIGINS=http://localhost:5173,https://app.cafearoma.mx

# --- Agente de impresión (emparejamiento y actualización automática) ---
# PUBLIC_API_URL=https://api.aroma.mx     # dirección que el instalador guarda en config.json (por defecto, el host de la petición)
# AGENTE_ULTIMA_VERSION=1.7.0             # versión publicada del agente
# AGENTE_URL_DESCARGA=https://.../agente.exe   # https obligatorio
# AGENTE_SHA256=                          # sha256 del agente.exe FIRMADO
# AGENTE_VERSION_MINIMA=1.7.0
# AGENTE_INSTALADOR_URL=https://.../GastronomyHub-Agente-Setup.exe
