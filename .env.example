# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Base de datos ---
# Local: variables DB_*. En Railway/producción usa DATABASE_URL (+ DB_SSL=require).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=inventarios
# DATABASE_URL=postgres://usuario:password@host:5432/inventarios
# DB_SSL=require

# --- Autenticación ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES=7d
# Opcional: blinda POST /api/auth/setup exigiendo el header x-setup-token
# SETUP_TOKEN=

# --- Cookie de sesión (frontend web) ---
# El login deja el JWT en una cookie httpOnly "gh_session" (además de devolverlo en el body).
# lax (recomendado): front y back en el mismo sitio (mismo dominio o subdominios, ej. app.aroma.mx + api.aroma.mx).
# none: front y back en dominios distintos (ej. dos *.up.railway.app). Requiere HTTPS (Secure automático).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true        # por defecto: true en producción
# COOKIE_DOMAIN=.aroma.mx   # solo si front y back están en subdominios distintos

# --- CORS ---
# Orígenes permitidos separados por coma (con credenciales, "*" no es válido).
# Vacío: en desarrollo acepta cualquier origen; en producción solo el mismo origen.
# CORS_ORIGINS=http://localhost:5173,https://app.cafearoma.mx
