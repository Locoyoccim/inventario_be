# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Base de datos ---
# Local: variables DB_*. En Railway/producción usa DATABASE_URL (+ DB_SSL=require).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=inventarios
# DATABASE_URL=postgres://usuario:password@host:5432/inventarios
# DB_SSL=require

# --- Autenticación ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES=7d
# Opcional: blinda POST /api/auth/setup exigiendo el header x-setup-token
# SETUP_TOKEN=

# --- CORS ---
# Orígenes permitidos separados por coma. Vacío = permite todos (solo desarrollo).
# CORS_ORIGINS=http://localhost:5173,https://app.cafearoma.mx
