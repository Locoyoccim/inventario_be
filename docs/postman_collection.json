{
  "info": {
    "name": "Inventario Café Aroma — API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Backend de inventario multiempresa. Configura baseUrl y empresa_id; corre Auth > Login para guardar el token automáticamente."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "empresa_id",
      "value": "4"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Setup (primer usuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/setup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "setup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empresa_id\": 4,\n  \"nombre\": \"Carlos\",\n  \"email\": \"carlos@aroma.mx\",\n  \"password\": \"secret123\",\n  \"codigo_ingreso\": \"0001\",\n  \"puesto\": \"Dueño\",\n  \"role_id\": 1\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@aroma.mx\",\n  \"password\": \"secret123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d=pm.response.json();",
                  "if(d.success){ pm.collectionVariables.set('token', d.data.token); pm.collectionVariables.set('empresa_id', String(d.data.user.empresa_id)); }",
                  "pm.test('token guardado', ()=>pm.expect(pm.collectionVariables.get('token')).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
