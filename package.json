{
    "name": "inventarios_app",
    "version": "1.0.0",
    "description": "",
    "main": "server.js",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "test": "NODE_ENV=test node --test",
        "test:ci": "export REQUIRE_DB=1 && node scripts/ci/exigir-db.js && NODE_ENV=test node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/ci/guardia-ci.js --test-reporter-destination=stderr",
        "start": "node server.js",
        "diagnosticar:login": "node scripts/diagnosticar_login.js",
        "dev": "NODE_ENV=development nodemon server.js",
        "migrate": "node db/migrate.js",
        "migrate:status": "node db/migrate.js status",
        "migrate:mark": "node db/migrate.js mark",
        "backup": "node scripts/respaldo.js respaldar",
        "backup:verify": "node scripts/respaldo.js verificar",
        "backup:restore": "node scripts/respaldo.js restaurar",
        "test:watch": "NODE_ENV=test node --test --watch",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^18.0.4",
        "express": "^5.1.0",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^10.0.14",
        "pg": "^8.16.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "nodemon": "^3.1.10",
        "prettier": "^3.3.3"
    }
}
